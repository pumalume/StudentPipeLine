# ==============================================================================
# SchoolPipeProject — environment configuration template
#
# Copy this file to `.env` and fill in real values for your environment.
# `.env` is gitignored — never commit real credentials.
# ==============================================================================

# --- Application ---
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_FILE=data/logs/pipeline.log
BATCH_SIZE=1000

# --- WordPress source (MySQL / MariaDB) ---
WP_DB_HOST=localhost
WP_DB_PORT=3306
WP_DB_NAME=wordpress
WP_DB_USER=wp_user
WP_DB_PASSWORD=changeme

# --- Target database (PostgreSQL) ---
PG_DB_HOST=localhost
PG_DB_PORT=5432
PG_DB_NAME=SchoolDatabase
PG_DB_SCHEMA=SchoolRegistration
PG_DB_USER=pg_user
PG_DB_PASSWORD=changeme

# --- File / API paths ---
DATA_INPUT_DIR=data/input
GDRIVE_CREDENTIALS_FILE=config/gdrive_credentials.json
